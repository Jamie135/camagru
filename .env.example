# Host port nginx is published on -> http://localhost:8080
NGINX_PORT=8080

# Host port for the Mailpit web UI -> http://localhost:8025
MAILPIT_UI_PORT=8025

# Host port for the Adminer database UI -> http://localhost:8081
ADMINER_PORT=8081

APP_URL=http://localhost:8080

# Envelope sender for confirmation and password-reset mail
MAIL_FROM=no-reply@camagru.local

DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# Host user, so files PHP writes into data/uploads stay yours
UID=1000
GID=1000
